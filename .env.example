# SatQuery AI - environment configuration (copy to .env and edit)

# 1 = load real VLM (Qwen3-VL + optional BigEarthNet LoRA)
# 0 = heuristic only (no GPU / no downloads)
SATQUERY_USE_HF=1

# Base vision-language model
SATQUERY_HF_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct

# Path to the LoRA adapter you trained on BigEarthNet.txt
# Put the unzipped final_adapter folder at weights/bigearthnet_lora/
# or set an absolute path here.
SATQUERY_LORA_ADAPTER=weights/bigearthnet_lora

# 1 = load base model in 4-bit (fits free Colab T4 / 8GB GPU)
SATQUERY_LOAD_4BIT=1
